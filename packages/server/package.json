{
  "name": "@kaya/server",
  "version": "0.4.0",
  "type": "module",
  "description": "Kaya server: hosts pi-agent-core Agents behind pi-server/pi-protocol.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-protocol": "0.84.4",
    "@earendil-works/pi-server": "0.84.4",
    "@earendil-works/pi-telemetry": "0.84.4",
    "@kaya/extensions": "0.4.0",
    "@kaya/mcp": "0.4.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-client": "0.84.4"
  }
}
