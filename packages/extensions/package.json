{
  "name": "@kaya/extensions",
  "version": "0.4.0",
  "type": "module",
  "description": "Kaya extension system: hook/tool/command registry, dispatcher, and loader.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "jiti": "2.7.0",
    "typebox": "1.3.7"
  }
}
